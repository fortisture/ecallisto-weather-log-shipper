# ── Secrets ─────────────────────────────────────────────────────────
# TLS material and the shared token. Never commit these.
secrets/
*.pem
token.txt
fingerprint.txt
config.json

# ── Station data ────────────────────────────────────────────────────
# Everything the station collects or downloads stays local. The repo
# carries the CODE that pulls, stores and displays this data -- not the
# data itself (it's large, it's reproducible, and it's not source).
data/
incoming_logs/
*.csv

# Dashboard JSON is derived from data/ on every server start.
web/api/

# ── Runtime state ───────────────────────────────────────────────────
.sender_state.json
.sender_state.json.tmp
state.json
*.log

__pycache__/
*.pyc

# Local tooling settings, not project source
.claude/

server.log
web/gallery/*
!web/gallery/gallery.json
